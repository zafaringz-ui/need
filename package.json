{
  "name": "zafar-bot",
  "version": "3.0.0",
  "description": "WhatsApp service with one isolated folder per command",
  "main": "index.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "node --expose-gc index.js",
    "check-all": "node scripts/check-all.js",
    "backup": "node scripts/backup.js",
    "add-owner": "node scripts/add-owner.js",
    "test": "node --test \"test/*.test.js\"",
    "test:isolation": "node --test test/isolation.test.js",
    "smoke:paper": "node scripts/smoke-paper.js",
    "demo:access": "node scripts/demo-access.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "axios": "^1.7.2",
    "node-webpmux": "^3.1.7",
    "pino": "^9.0.0",
    "qrcode-terminal": "^0.12.0",
    "ruhend-scraper": "10.0.3",
    "tough-cookie": "^6.0.2",
    "yt-search": "^2.13.1"
  },
  "optionalDependencies": {
    "webtorrent": "^3.0.21"
  },
  "overrides": {
    "minimatch": "^3.1.5"
  }
}
